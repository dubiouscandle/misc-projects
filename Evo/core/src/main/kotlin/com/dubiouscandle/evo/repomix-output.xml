package com.dubiouscandle.evo

import com.badlogic.gdx.physics.box2d.BodyDef
import com.badlogic.gdx.physics.box2d.FixtureDef
import com.badlogic.gdx.physics.box2d.PolygonShape
import kotlin.math.min

class RunningSimulator(genome: Genome, slope: Float = 0f) : SoloSimulator(genome) {
    init {
        val groundDef = BodyDef()
        groundDef.position.set(0f, -20f)
        val groundBody = world.createBody(groundDef)
        groundBody.setTransform(groundBody.position, slope)
        val groundShape = PolygonShape()
        groundShape.setAsBox(1000f, 10f)

        val fixtureDef = FixtureDef()
        fixtureDef.shape = groundShape
        fixtureDef.friction = 1f
        fixtureDef.filter.categoryBits = 0x0001
        fixtureDef.filter.maskBits = -1

        groundBody.createFixture(fixtureDef)
        groundShape.dispose()

        var lowestY = Float.MAX_VALUE // FIX: Initialized a variable to track the absolute lowest point of the creature
        for (body in creature.bodies) { // FIX: Iterated through the creature's bodies to find the lowest Y
            for (fixture in body.fixtureList) { // FIX: Iterated through each body's fixtures to account for their physical radius
                lowestY = min(lowestY, body.position.y - fixture.shape.radius) // FIX: Updated lowestY using the body's position minus its radius
            } // FIX: Concluded fixture iteration
        } // FIX: Concluded body iteration
        val shiftY = -9f - lowestY // FIX: Calculated the vertical distance needed to shift the lowest point to the ground's top edge at y = -10
        for (body in creature.bodies) { // FIX: Iterated through the creature's bodies again to apply the translation
            body.setTransform(body.position.x, body.position.y + shiftY, body.angle) // FIX: Shifted the body vertically so the creature rests precisely on the ground
        } // FIX: Concluded translation iteration
    }

    override fun getFitness(): Float {
        var minX = Float.MAX_VALUE
        for (body in creature.bodies) {
            minX = min(body.worldCenter.x, minX)
        }
        return if (creature.bodies.isNotEmpty()) minX else 0f
    }
}
